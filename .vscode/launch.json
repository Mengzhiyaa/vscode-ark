{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Ark + Supervisor",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionDevelopmentPath=${workspaceFolder}/../vscode-supervisor"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js",
        "${workspaceFolder}/../vscode-supervisor/dist/**/*.js"
      ],
      "preLaunchTask": "prepare ark extension development"
    },
    {
      "name": "Ark Extension Tests",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionDevelopmentPath=${workspaceFolder}/../vscode-supervisor",
        "--extensionTestsPath=${workspaceFolder}/out/test/index"
      ],
      "outFiles": [
        "${workspaceFolder}/out/test/**/*.js",
        "${workspaceFolder}/dist/**/*.js",
        "${workspaceFolder}/../vscode-supervisor/dist/**/*.js"
      ],
      "preLaunchTask": "prepare ark extension tests"
    }
  ]
}
